# ---------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=""

# "service_role" secret key (or the new "sb_secret_..." key).
# Backend only - never put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket for product images (created by supabase/schema.sql)
SUPABASE_STORAGE_BUCKET="product-images"

# ---------------------------------------------------------------
# Auth
# ---------------------------------------------------------------
# Signs admin session tokens
JWT_SECRET="replace-with-a-long-random-string"

# Admin dashboard login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Clerk publishable key (public) - used to verify signed-in shoppers
CLERK_PUBLISHABLE_KEY="pk_test_..."
